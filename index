/* =====================================================================
   HELFER
   ===================================================================== */
function HEFT(nr){ return '<span class="heft">📓 ins Heft · Aufg. '+nr+'</span>'; }
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escAttr(s){ return esc(s).replace(/"/g,'&quot;'); }
function escRe(s){ return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }
function shuffle(a){ a=a.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }

const VERBS=["ist","sind","war","waren","wurde","wurden","hat","hatte","hatten","beschloss","verbot","verboten","zerstörten","zerstörte","begann","begannen","führte","führten","ernannte","nutzten","setzte","durfte","durften","stimmte","kämpften","starben","ermordeten","erschossen","überfiel","besetzte","besetzten","kapitulierte","verfolgte","verfolgten","floh","flohen","erinnert","warfen","brannte","brannten","glaubten","riefen","verteilte","versuchten","wehrten","halfen","versteckten","leisteten","gehört","erklärt","zeigt","stieg","stiegen","lernten","sollten","kamen","machten","mussten","arbeiteten","wollten","gewinnen","töten","töteten","plante","planten","gab","raubte"];

function annotate(raw){
  let s=esc(raw);
  s=s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  // Verben (dezent) – vor den Fachbegriffen, damit keine Verschachtelung entsteht
  for(const v of VERBS){
    const re=new RegExp('(?![^<]*>)(?<![\\wäöüßÄÖÜ])('+escRe(v)+')(?![\\wäöüßÄÖÜ])');
    s=s.replace(re,'<span class="vb">$1</span>');
  }
  // Fachbegriffe (längste zuerst), jeweils erstes Vorkommen
  const terms=Object.keys(TERM_DEFS).sort((a,b)=>b.length-a.length);
  for(const t of terms){
    const re=new RegExp('(?![^<]*>)(?<![\\wäöüßÄÖÜ-])('+escRe(t)+')(?![\\wäöüßÄÖÜ])');
    if(re.test(s)) s=s.replace(re,'<span class="fach" tabindex="0" data-def="'+escAttr(TERM_DEFS[t])+'">$1</span>');
  }
  return s;
}
function paras(arr){ return arr.map(p=>'<p>'+annotate(p)+'</p>').join(''); }

function toast(msg){
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2200);
}
function updateProgress(){
  const total=STATIONS.filter(s=>s.status!=='arbeit'||s.id!=='glossar').length;
  const done=STATIONS.filter(s=>state.done[s.id]).length;
  const pct=total?Math.round(done/STATIONS.length*100):0;
  document.getElementById('pfill').style.width=pct+'%';
  document.getElementById('ptext').textContent=pct+' %';
}

