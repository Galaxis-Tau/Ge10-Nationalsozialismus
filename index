function renderSim(){
  const host=document.getElementById('simHost'); if(!host||!cur.sim) return;
  const s=cur.sim;
  host.innerHTML='<p class="sim-hint">'+esc(s.hint||'')+'</p><div id="simBody"></div><button class="check-btn" onclick="checkSim()">Prüfen</button><div class="sim-result" id="simRes"></div>';
  const b=document.getElementById('simBody');
  if(s.type==='sortier') simSortier(b,s);
  else if(s.type==='ordnen') simOrdnen(b,s);
  else if(s.type==='stufen') simStufen(b,s);
  else if(s.type==='wahrfalsch') simWF(b,s);
  else if(s.type==='zuordnen') simZuordnen(b,s);
  else if(s.type==='glossaralle') { b.innerHTML=glossarAlleHTML(); host.querySelector('.check-btn').style.display='none'; }
}
function simSortier(b,s){
  b.innerHTML=`<div class="movable" id="pool">${s.items.map((it,i)=>`<span class="token" draggable="true" data-i="${i}" ondragstart="dragTok(event)">${esc(it.t)}</span>`).join('')}</div>
    <div class="baskets">
      <div class="basket" data-b="0" ondragover="event.preventDefault()" ondrop="dropTok(event,0)"><h4>${esc(s.b0)}</h4></div>
      <div class="basket" data-b="1" ondragover="event.preventDefault()" ondrop="dropTok(event,1)"><h4>${esc(s.b1)}</h4></div>
    </div>`;
}
let dragI=null;
function dragTok(e){ dragI=e.target.dataset.i; e.dataTransfer.setData('text',dragI); }
function dropTok(e,basket){ e.preventDefault(); const i=e.dataTransfer.getData('text'); const tok=document.querySelector('#simBody .token[data-i="'+i+'"]'); if(tok){ tok.classList.add('placed'); tok.dataset.b=basket; e.currentTarget.appendChild(tok);} }
function simOrdnen(b,s){
  const sh=shuffle(s.items.map((t,i)=>({t,i})));
  b.innerHTML=`<div class="slotline">${s.items.map((_,pos)=>`<div class="slot"><div class="num">${pos+1}</div>
    <select data-pos="${pos}">${['<option value="">– wählen –</option>'].concat(sh.map(o=>'<option value="'+o.i+'">'+esc(o.t)+'</option>')).join('')}</select></div>`).join('')}</div>`;
}
function simStufen(b,s){
  b.innerHTML=`<div class="slotline">${s.items.map((it,i)=>`<div class="slot"><div class="num">${i+1}</div><span style="flex:1">${esc(it.t)}</span>
    <select data-i="${i}"><option value="">– Stufe wählen –</option>${s.stufen.map((st,si)=>'<option value="'+si+'">'+esc(st)+'</option>').join('')}</select></div>`).join('')}</div>`;
}
function simWF(b,s){
  b.innerHTML=s.items.map((it,i)=>`<div class="wf-item"><span>${annotate(it.t)}</span>
    <div class="wf-btns"><button data-i="${i}" data-v="1" onclick="wfSel(this)">wahr</button><button data-i="${i}" data-v="0" onclick="wfSel(this)">falsch</button></div></div>`).join('');
}
function wfSel(btn){ btn.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('sel')); btn.classList.add('sel'); }
function simZuordnen(b,s){
  const defs=shuffle(s.pairs.map((p,i)=>({d:p.d,i})));
  b.innerHTML=`<div class="match-grid">${s.pairs.map((p,i)=>`<div class="slot"><span style="flex:1"><b>${esc(p.t)}</b></span>
    <select data-i="${i}"><option value="">– Erklärung –</option>${defs.map(o=>'<option value="'+o.i+'">'+esc(o.d)+'</option>').join('')}</select></div>`).join('')}</div>`;
}
function checkSim(){
  const s=cur.sim, res=document.getElementById('simRes'); let ok=false,msg='';
  if(s.type==='sortier'){
    let right=0,tot=s.items.length,placed=0;
    document.querySelectorAll('#simBody .token').forEach(t=>{ if(t.dataset.b!==undefined){placed++; if(+t.dataset.b===s.items[+t.dataset.i].b) right++;} });
    ok=right===tot&&placed===tot; msg=ok?'✅ Alles richtig einsortiert!':`Noch nicht ganz: ${right} von ${tot} richtig${placed<tot?' (nicht alle eingeordnet)':''}.`;
  } else if(s.type==='ordnen'){
    const sel=[...document.querySelectorAll('#simBody select')]; let right=0;
    sel.forEach((se,pos)=>{ if(se.value!==''&&+se.value===pos) right++; });
    ok=right===s.items.length; msg=ok?'✅ Reihenfolge korrekt!':`${right} von ${s.items.length} an der richtigen Stelle.`;
  } else if(s.type==='stufen'){
    const sel=[...document.querySelectorAll('#simBody select')]; let right=0;
    sel.forEach(se=>{ const i=+se.dataset.i; if(se.value!==''&&+se.value===s.items[i].s) right++; });
    ok=right===s.items.length; msg=ok?'✅ Alle richtig zugeordnet!':`${right} von ${s.items.length} richtig.`;
  } else if(s.type==='wahrfalsch'){
    let right=0; s.items.forEach((it,i)=>{ const sel=document.querySelector('#simBody button.sel[data-i="'+i+'"]'); if(sel&&+sel.dataset.v===(it.w?1:0)) right++; });
    ok=right===s.items.length; msg=ok?'✅ Alles richtig beurteilt!':`${right} von ${s.items.length} richtig.`;
  } else if(s.type==='zuordnen'){
    const sel=[...document.querySelectorAll('#simBody select')]; let right=0;
    sel.forEach(se=>{ const i=+se.dataset.i; if(se.value!==''&&+se.value===i) right++; });
    ok=right===s.pairs.length; msg=ok?'✅ Alle Paare stimmen!':`${right} von ${s.pairs.length} richtig zugeordnet.`;
  }
  res.innerHTML='<span class="'+(ok?'ok-txt':'no-txt')+'">'+msg+'</span>';
  if(ok) toast('Übung gelöst 👍');
}

