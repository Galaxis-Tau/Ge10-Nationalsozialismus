      <div class="muster">${consolidated||'—'}</div>
    </div>`;
}

/* ---------- QUELLENANALYSE ---------- */
function renderQuelle(){
  const q=cur.quelle;
  const felder=[['wer','Wer schreibt den Text?'],['wann','Wann wurde der Text geschrieben?'],['wo','Wo passierten die Ereignisse?'],['fuerwen','Wer sollte/soll diesen Text lesen?'],['warum','Warum schreibt der Autor über die Ereignisse?']];
  const felderRows=felder.map(f=>`<tr><td class="q">${f[1]}</td><td>
      <textarea placeholder="Deine Antwort …"></textarea>
      <button class="reveal-btn" onclick="this.nextElementSibling.classList.toggle('show')">💡 Musterlösung</button>
      <div class="muster">${esc(q.felder[f[0]]||'—')}</div></td></tr>`).join('');
  const fragen=(q.fragen||[]).map((fr,i)=>`<div class="qa-q"><div class="qh">${i+1}) ${annotate(fr.q)} ${HEFT('Q'+(i+1))}</div>
      <textarea placeholder="Deine Antwort …"></textarea>
      <button class="reveal-btn" onclick="this.nextElementSibling.classList.toggle('show')">💡 Musterlösung</button>
      <div class="muster">${annotate(fr.muster)}</div></div>`).join('');
  return `
  <div class="instruction">🔎 <b>Quellenanalyse.</b> Lies zuerst die Quelle. Fülle dann das Analyse-Schema aus und beantworte die Fragen. Prüfe mit „Musterlösung“ und <b>schreibe das Ergebnis in deine Mappe</b>.</div>
  <div class="card">
    <h3>${esc(q.titel)}</h3>
    <div class="qsrc">${q.einleitung?'<p style="color:var(--muted);font-style:italic">'+esc(q.einleitung)+'</p>':''}${q.text.map(p=>'<p>'+annotate(p)+'</p>').join('')}<p class="angabe">Quelle: ${esc(q.angabe)}</p></div>
