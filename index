<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lernreise · Nationalsozialismus & Zweiter Weltkrieg</title>
<style>
:root{
  /* Ruhige, zurückhaltende Apple-Palette: neutrale Flächen, ein Interaktions-Blau, gedämpfte Akzente */
  --brand:#33415c; --brand2:#4a5a78;
  --maroon:#33415c; --maroon2:#4a5a78; --pink:#eaeef4;   /* Aliase: alte Namen -> neue Töne */
  --blue:#0071e3; --blue-l:#e7f1fd;
  --green:#1f8a3b; --green-l:#e8f5ec;
  --yellow:#b06a00; --yellow-l:#fbf1dd;
  --purple:#6b4fa0; --teal:#0a7a68;
  --ink:#1d1d1f; --muted:#6e6e73; --line:rgba(0,0,0,.10);
  --paper:#f5f5f7; --card:#ffffff; --sand:#eef1f6;
  --r:20px; --r-s:14px;
  --sh:0 1px 1px rgba(0,0,0,.04),0 6px 20px rgba(0,0,0,.06);
  --sh-h:0 6px 16px rgba(0,0,0,.08),0 24px 60px rgba(0,0,0,.12);
  --ease:cubic-bezier(.2,.8,.2,1);
  --maxw:1060px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",system-ui,sans-serif;
  color:var(--ink); background:var(--paper); font-size:17px; line-height:1.5;
  letter-spacing:-.003em; -webkit-font-smoothing:antialiased; font-optical-sizing:auto;
}
h1,h2,h3{line-height:1.06; margin:0; letter-spacing:-.021em}
h1{letter-spacing:-.03em}
a{color:var(--blue)}
button{font-family:inherit}
.wrap{max-width:var(--maxw); margin:0 auto; padding:0 20px}

/* ---------- Header ---------- */
header.top{
  position:sticky; top:0; z-index:50;
  background:rgba(28,32,44,.68);
  backdrop-filter:blur(22px) saturate(180%); -webkit-backdrop-filter:blur(22px) saturate(180%);
  color:#fff; border-bottom:1px solid rgba(255,255,255,.12);
}
.top .wrap{display:flex; align-items:center; gap:16px; padding-top:12px; padding-bottom:12px}
.brand{display:flex; flex-direction:column; min-width:0}
.brand b{font-weight:650; font-size:1.02rem; letter-spacing:-.01em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.brand span{font-size:.78rem; opacity:.85}
.progress{flex:1; min-width:80px}
.progress .bar{height:9px; background:rgba(255,255,255,.25); border-radius:99px; overflow:hidden}
.progress .fill{height:100%; width:0%; background:linear-gradient(90deg,#ffd27a,#ffe8b0); border-radius:99px; transition:width .5s cubic-bezier(.2,.8,.2,1)}
.progress small{opacity:.9; font-size:.72rem}
.btn-home{background:rgba(255,255,255,.16); color:#fff; border:1px solid rgba(255,255,255,.3); border-radius:99px; padding:9px 16px; font-size:.9rem; cursor:pointer; white-space:nowrap; transition:transform .12s ease, background .2s}
.btn-home:active{transform:scale(.96)}
.btn-home:hover{background:rgba(255,255,255,.28)}

/* ---------- Hero ---------- */
.hero{padding:56px 0 30px; text-align:center}
.hero .kicker{color:var(--maroon2); font-weight:650; letter-spacing:.02em; text-transform:uppercase; font-size:.8rem}
.hero h1{font-size:clamp(2.1rem,6vw,3.6rem); margin:10px 0 14px}
.hero .lead{max-width:640px; margin:0 auto; color:var(--muted); font-size:1.12rem}
.legend{display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin:24px 0 4px}
.legend .tag{background:var(--card); border:1px solid var(--line); border-radius:99px; padding:7px 14px; font-size:.85rem; box-shadow:var(--sh)}
.legend .tag b{font-weight:650}

/* ---------- Einstufungstest (Station 0) ---------- */
.est-btn{display:flex; align-items:center; gap:18px; width:100%; text-align:left; cursor:pointer;
  background:linear-gradient(135deg,#33415c,#4a5a78); color:#fff; border:none; border-radius:var(--r);
  padding:22px 26px; box-shadow:var(--sh); transition:transform .18s var(--ease), box-shadow .18s var(--ease); margin:6px 0 4px}
.est-btn:hover{transform:translateY(-3px); box-shadow:var(--sh-h)}
.est-btn:active{transform:translateY(-1px) scale(.995)}
.est-btn .ic{font-size:2.2rem; flex:none}
.est-btn h3{font-size:1.28rem; margin:0 0 3px; color:#fff}
.est-btn p{margin:0; opacity:.9; font-size:.95rem}
.est-btn .go{margin-left:auto; flex:none; background:rgba(255,255,255,.18); border-radius:99px; padding:10px 16px; font-size:.9rem; white-space:nowrap}
.est-btn .done-badge{margin-left:auto; flex:none; background:#1f8a3b; border-radius:99px; padding:8px 15px; font-size:.88rem; font-weight:600; white-space:nowrap}
.est-wrap{padding:26px 0 90px; animation:fade .35s ease}
.est-q{background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:20px 22px; box-shadow:var(--sh); margin:14px 0}
.est-q .qh{font-weight:600; margin-bottom:12px}
.est-opts{display:grid; gap:10px}
.est-opt{border:1.5px solid var(--line); background:#fff; border-radius:12px; padding:12px 15px; cursor:pointer; font-size:1rem; transition:transform .1s var(--ease), border-color .2s, background .2s; text-align:left}
.est-opt:hover{border-color:var(--brand2)}
.est-opt:active{transform:scale(.99)}
.est-opt.sel{border-color:var(--brand); background:var(--sand)}
.est-result{background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:26px; box-shadow:var(--sh); margin-top:16px; text-align:center; display:none}
.est-result.show{display:block; animation:fade .3s ease}
.est-result .badge{display:inline-block; font-size:1.05rem; font-weight:700; padding:10px 20px; border-radius:99px; margin:10px 0}
.est-result .b1{background:var(--green-l); color:var(--green)}
.est-result .b2{background:var(--yellow-l); color:var(--yellow)}
.est-result .b3{background:var(--blue-l); color:var(--blue)}

/* ---------- Map grid ---------- */
.grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:20px; padding:20px 0 60px}
.tile{position:relative; background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:22px; cursor:pointer; box-shadow:var(--sh); transition:transform .18s cubic-bezier(.2,.8,.2,1), box-shadow .18s; overflow:hidden; text-align:left}
.tile:hover{transform:translateY(-4px); box-shadow:var(--sh-h)}
.tile:active{transform:translateY(-1px) scale(.995)}
.tile .accent{position:absolute; inset:0 auto 0 0; width:6px}
.tile .ic{font-size:2rem}
.tile .nr{font-size:.78rem; color:var(--muted); font-weight:650; letter-spacing:.03em}
.tile h3{font-size:1.14rem; margin:8px 0 6px}
.tile .meta{display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-top:10px}
.chip{font-size:.72rem; padding:4px 10px; border-radius:99px; font-weight:600}
.chip.pflicht{background:var(--pink); color:var(--maroon)}
.chip.wahl{background:var(--yellow-l); color:var(--yellow)}
.chip.arbeit{background:var(--blue-l); color:var(--blue)}
.tile .doneflag{position:absolute; top:14px; right:14px; font-size:1.1rem; opacity:0; transform:scale(.5); transition:.25s cubic-bezier(.2,.9,.3,1.3)}
.tile.done .doneflag{opacity:1; transform:scale(1)}
.tile.done{border-color:#bfe3c0}
.section-title{font-size:1.5rem; margin:36px 0 4px; font-weight:680}
.section-sub{color:var(--muted); margin:0 0 8px}

/* ---------- Station view ---------- */
.station{display:none; padding:26px 0 90px}
.station.active{display:block; animation:fade .35s ease}
@keyframes fade{from{opacity:0; transform:translateY(8px)}to{opacity:1; transform:none}}
.st-head{background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:24px; box-shadow:var(--sh); position:relative; overflow:hidden}
.st-head .bar{position:absolute; inset:0 0 auto 0; height:6px}
.st-head .row1{display:flex; align-items:center; gap:14px}
.st-head .ic{font-size:2.4rem}
.st-head .nr{color:var(--muted); font-weight:650; font-size:.82rem}
.st-head h2{font-size:1.7rem; margin:2px 0}
.st-head .leit{margin:14px 0 0; font-size:1.06rem}
.st-head .leit b{color:var(--maroon)}
.kann{margin:14px 0 0; padding:14px 16px; background:var(--sand); border-radius:var(--r-s)}
.kann b{display:block; margin-bottom:6px; font-size:.9rem}
.kann ul{margin:0; padding-left:20px}
.kann li{margin:3px 0}
.komp{display:flex; gap:6px; flex-wrap:wrap; margin-top:12px}
.komp .k{font-size:.7rem; background:#efe9e0; color:#7a6a55; border-radius:6px; padding:3px 8px; font-weight:600}

/* ---------- Tabs ---------- */
.tabs{display:flex; gap:8px; flex-wrap:wrap; margin:20px 0 14px; position:sticky; top:64px; z-index:20; background:linear-gradient(180deg,var(--paper) 70%,transparent); padding:8px 0}
.tab{border:1px solid var(--line); background:var(--card); border-radius:99px; padding:9px 16px; font-size:.92rem; cursor:pointer; transition:transform .12s, background .2s, color .2s; white-space:nowrap}
.tab:active{transform:scale(.96)}
.tab.active{background:var(--maroon); color:#fff; border-color:var(--maroon)}
.panel{display:none}
.panel.active{display:block; animation:fade .3s ease}
.card{background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:22px; box-shadow:var(--sh); margin-bottom:18px}
.card h3{font-size:1.15rem; margin-bottom:8px}
.instruction{background:var(--blue-l); border-left:5px solid var(--blue); border-radius:12px; padding:12px 16px; margin-bottom:16px; font-size:.98rem}
.instruction b{color:var(--blue)}

/* ---------- Level switch ---------- */
.levels{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:6px}
.lvl{border:2px solid transparent; border-radius:99px; padding:8px 16px; font-weight:600; cursor:pointer; font-size:.9rem; transition:transform .12s, background .2s}
.lvl:active{transform:scale(.96)}
.lvl[data-l="basis"]{background:var(--green-l); color:var(--green)}
.lvl[data-l="mittel"]{background:var(--yellow-l); color:var(--yellow)}
.lvl[data-l="erweitert"]{background:var(--blue-l); color:var(--blue)}
.lvl.active[data-l="basis"]{border-color:var(--green)}
.lvl.active[data-l="mittel"]{border-color:var(--yellow)}
.lvl.active[data-l="erweitert"]{border-color:var(--blue)}
.reading-aids{display:flex; gap:14px; flex-wrap:wrap; align-items:center; margin:8px 0 16px; font-size:.9rem; color:var(--muted)}
.switch{display:inline-flex; align-items:center; gap:8px; cursor:pointer; user-select:none}
.switch input{display:none}
.switch .track{width:42px; height:24px; background:#d7d0c6; border-radius:99px; position:relative; transition:background .2s}
.switch .track::after{content:""; position:absolute; top:2px; left:2px; width:20px; height:20px; background:#fff; border-radius:50%; box-shadow:0 1px 3px rgba(0,0,0,.25); transition:transform .22s cubic-bezier(.2,.9,.3,1.3)}
.switch input:checked + .track{background:var(--green)}
.switch input:checked + .track::after{transform:translateX(18px)}

.textbody{font-size:1.06rem}
.textbody p{margin:0 0 12px}
.bold-keys .fach{font-weight:800; color:#000}
.show-verbs .vb{border-bottom:2px dotted #b9b2a6}
.fach{border-bottom:1px dashed var(--purple); cursor:help; position:relative; color:inherit}
.fach:hover, .fach:focus{background:#f3ecf7; outline:none}
.fach::after{content:attr(data-def); position:absolute; left:50%; bottom:135%; transform:translateX(-50%) translateY(6px); background:#2b2140; color:#fff; padding:9px 12px; border-radius:10px; width:max-content; max-width:260px; font-size:.82rem; line-height:1.35; font-weight:400; opacity:0; pointer-events:none; transition:opacity .18s, transform .18s; box-shadow:var(--sh-h); z-index:30; white-space:normal}
.fach::before{content:""; position:absolute; left:50%; bottom:135%; transform:translateX(-50%) translateY(6px); border:7px solid transparent; border-top-color:#2b2140; opacity:0; transition:opacity .18s, transform .18s; z-index:30}
.fach:hover::after,.fach:focus::after,.fach:hover::before,.fach:focus::before{opacity:1; transform:translateX(-50%) translateY(0)}

.wortspeicher{background:var(--green-l); border-radius:14px; padding:12px 14px; margin:14px 0}
.wortspeicher b{font-size:.85rem; color:var(--green)}
.pills{display:flex; gap:8px; flex-wrap:wrap; margin-top:8px}
.pill{background:#fff; border:1px solid #bfe0c0; color:#215a24; border-radius:99px; padding:5px 12px; font-size:.86rem; cursor:default}

/* ---------- Task list ---------- */
.task{border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin:10px 0; background:#fff}
.task .op{display:inline-block; font-size:.7rem; font-weight:700; letter-spacing:.03em; padding:2px 8px; border-radius:6px; background:#efe9e0; color:#7a6a55; margin-right:8px; text-transform:uppercase}
.task .afb{background:var(--blue-l); color:var(--blue)}
.heft{display:inline-flex; align-items:center; gap:4px; font-size:.72rem; background:#fff4d6; color:#8a6a12; border:1px solid #f0dca0; border-radius:8px; padding:2px 8px; margin-left:6px; vertical-align:middle}
.reveal-btn{margin-top:10px; border:1px dashed var(--maroon2); background:#fff; color:var(--maroon); border-radius:10px; padding:7px 14px; font-size:.85rem; cursor:pointer; transition:transform .12s}
.reveal-btn:active{transform:scale(.97)}
.muster{margin-top:10px; background:var(--pink); border-left:4px solid var(--maroon2); border-radius:10px; padding:12px 14px; font-size:.95rem; display:none}
.muster.show{display:block; animation:fade .25s ease}
.muster b{color:var(--maroon)}
.mappe{margin-top:14px; background:#fbfaf7; border:1px dashed #cfc6b6; border-radius:12px; padding:14px 16px}
.mappe .m-h{font-weight:650; margin-bottom:6px; display:flex; align-items:center; gap:8px}

/* ---------- Quellenanalyse ---------- */
.qtable{width:100%; border-collapse:collapse; margin-top:6px}
.qtable td{border:1px solid var(--line); padding:10px 12px; vertical-align:top}
.qtable td.q{width:34%; font-weight:600; background:#faf7f2}
.qtable textarea, .qa-q textarea{width:100%; border:1px solid var(--line); border-radius:10px; padding:8px 10px; font-family:inherit; font-size:.95rem; resize:vertical; min-height:44px; background:#fff}
.qsrc{background:#f5eef8; border-left:5px solid var(--purple); border-radius:12px; padding:14px 16px; margin:6px 0 16px}
.qsrc p{margin:0 0 10px}
.qsrc .angabe{font-size:.8rem; color:var(--muted)}
.dropwrap{display:flex; gap:10px; flex-wrap:wrap}
.dropwrap select{border:1px solid var(--line); border-radius:10px; padding:8px 10px; font-family:inherit; font-size:.92rem; background:#fff}
.mini-muster{font-size:.86rem; color:var(--maroon); margin-top:6px; display:none}
.mini-muster.show{display:block}
.qa-q{margin:12px 0}
.qa-q .qh{font-weight:600; margin-bottom:6px}

/* ---------- Simulation ---------- */
.sim-hint{color:var(--muted); font-size:.92rem; margin-bottom:12px}
.baskets{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:12px}
.basket{border:2px dashed var(--line); border-radius:14px; padding:12px; min-height:120px; background:#fff}
.basket h4{margin:0 0 8px; font-size:.95rem}
.basket.ok{border-color:var(--green)}
.movable{display:flex; gap:8px; flex-wrap:wrap; margin:12px 0}
.token{background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px 12px; cursor:grab; font-size:.9rem; box-shadow:var(--sh); transition:transform .12s}
.token:active{cursor:grabbing; transform:scale(1.04)}
.token.placed{background:var(--sand)}
.slotline{display:flex; flex-direction:column; gap:8px; margin-top:10px}
.slot{display:flex; align-items:center; gap:10px; border:1px solid var(--line); border-radius:10px; padding:8px 10px; background:#fff}
.slot .num{width:26px; height:26px; border-radius:50%; background:var(--maroon); color:#fff; display:grid; place-items:center; font-size:.8rem; font-weight:700; flex:none}
.slot select{flex:1; border:1px solid var(--line); border-radius:8px; padding:7px; font-family:inherit}
.wf-item{display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid var(--line); border-radius:12px; padding:10px 12px; margin:8px 0; background:#fff}
.wf-btns{display:flex; gap:6px; flex:none}
.wf-btns button{border:1px solid var(--line); background:#fff; border-radius:8px; padding:6px 12px; cursor:pointer; font-size:.85rem}
.wf-btns button.sel{background:var(--maroon); color:#fff; border-color:var(--maroon)}
.match-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:10px}
.check-btn{margin-top:14px; background:var(--maroon); color:#fff; border:none; border-radius:12px; padding:11px 20px; font-size:.95rem; cursor:pointer; transition:transform .12s, filter .2s}
.check-btn:active{transform:scale(.97)}
.check-btn:hover{filter:brightness(1.06)}
.sim-result{margin-top:12px; font-weight:600}
.ok-txt{color:var(--green)} .no-txt{color:#b03a2e}

/* ---------- Quiz ---------- */
.qq{border:1px solid var(--line); border-radius:16px; padding:16px 18px; margin:12px 0; background:#fff}
.qq .qtxt{font-weight:650; margin-bottom:10px}
.opt{display:block; width:100%; text-align:left; border:1px solid var(--line); background:#fff; border-radius:12px; padding:12px 14px; margin:8px 0; cursor:pointer; font-size:.98rem; transition:transform .1s, border-color .2s, background .2s}
.opt:hover{border-color:var(--maroon2)}
.opt:active{transform:scale(.99)}
.opt.correct{background:var(--green-l); border-color:var(--green)}
.opt.wrong{background:#fbe9e7; border-color:#e0897c}
.opt .fb{display:block; font-size:.85rem; margin-top:6px; color:var(--muted)}
.lw{margin-top:16px; text-align:center; padding:18px; border-radius:16px; background:var(--sand); border:1px dashed #c9bfae}
.lw.locked{opacity:.65}
.lw .word{font-size:1.5rem; font-weight:750; letter-spacing:.08em; color:var(--maroon); filter:blur(7px); transition:filter .5s}
.lw.solved .word{filter:none}
.lw small{display:block; color:var(--muted); margin-top:6px}
.quiz-tools{display:flex; gap:10px; align-items:center; margin-bottom:10px}
.ghost{border:1px solid var(--line); background:#fff; border-radius:10px; padding:8px 14px; cursor:pointer; font-size:.85rem}

/* ---------- Glossar / videos ---------- */
.gloss-item{display:flex; gap:12px; align-items:flex-start; border-bottom:1px solid var(--line); padding:12px 0}
.gloss-item input{margin-top:5px; width:18px; height:18px}
.gloss-item .term{font-weight:650}
.gloss-item .src{font-size:.75rem; color:var(--muted)}
.vid{display:flex; gap:14px; align-items:center; border:1px solid var(--line); border-radius:14px; padding:14px; margin:10px 0; background:#fff}
.vid .play{font-size:1.6rem}
.vid .info{flex:1}
.vid .info b{display:block}
.vid .info small{color:var(--muted)}
.vid a{white-space:nowrap; background:var(--teal); color:#fff; text-decoration:none; padding:9px 14px; border-radius:10px; font-size:.85rem}

/* ---------- Station foot ---------- */
.st-foot{display:flex; gap:12px; align-items:center; justify-content:space-between; margin-top:20px; flex-wrap:wrap}
.mark-done{background:var(--green); color:#fff; border:none; border-radius:12px; padding:12px 22px; font-size:1rem; cursor:pointer; transition:transform .12s, filter .2s}
.mark-done:active{transform:scale(.97)}
.mark-done.is-done{background:#8a8a8a}
.nav-lr{display:flex; gap:10px}
.nav-lr button{border:1px solid var(--line); background:#fff; border-radius:12px; padding:11px 18px; cursor:pointer}
.tipbox .reveal-btn{border-style:solid}

/* ---------- Toast ---------- */
#toast{position:fixed; left:50%; bottom:26px; transform:translateX(-50%) translateY(30px); background:#1d1d1f; color:#fff; padding:13px 22px; border-radius:14px; box-shadow:var(--sh-h); opacity:0; pointer-events:none; transition:opacity .3s, transform .3s cubic-bezier(.2,.9,.3,1.3); z-index:100; font-size:.95rem}
#toast.show{opacity:1; transform:translateX(-50%) translateY(0)}

/* ---------- Laufzettel modal ---------- */
.modal{position:fixed; inset:0; background:rgba(20,15,15,.45); backdrop-filter:blur(6px); display:none; z-index:80; align-items:flex-start; justify-content:center; padding:40px 16px; overflow:auto}
.modal.show{display:flex; animation:fade .25s ease}
.sheet{background:var(--card); border-radius:22px; max-width:760px; width:100%; padding:26px; box-shadow:var(--sh-h)}
.sheet h2{margin-bottom:12px}
.sheet table{width:100%; border-collapse:collapse; font-size:.9rem}
.sheet th,.sheet td{border-bottom:1px solid var(--line); text-align:left; padding:8px 6px; vertical-align:top}
.sheet .x{float:right; cursor:pointer; border:none; background:var(--sand); border-radius:10px; padding:6px 12px}

@media(max-width:640px){
  body{font-size:16px}
  .progress{display:none}
  .tabs{top:60px}
  .baskets{grid-template-columns:1fr}
  .match-grid{grid-template-columns:1fr}
  .qtable td.q{width:42%}
}
@media (prefers-reduced-motion: reduce){
  *{transition:none !important; animation:none !important; scroll-behavior:auto}
}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <div class="brand"><b id="brandTitle">Lernreise</b><span id="brandSub">Geschichte · Klasse 10</span></div>
    <div class="progress"><div class="bar"><div class="fill" id="pfill"></div></div><small id="ptext">0 %</small></div>
    <button class="btn-home" onclick="openLauf()">📋 Laufzettel</button>
    <button class="btn-home" onclick="goHome()">🏠 Übersicht</button>
  </div>
</header>

<main class="wrap">
