let cur=null;
function openStation(id){
  cur=STATIONS.find(s=>s.id===id); if(!cur) return;
  if(!state.level[id]) state.level[id]=state.recommendedLevel||'mittel';
  document.getElementById('home').style.display='none';
  const v=document.getElementById('stationView'); v.classList.add('active');
  const tabs=[['text','📖 Text & Auftrag']];
  if(cur.quelle) tabs.push(['quelle','🔎 Quellenanalyse']);
  if(cur.sim) tabs.push(['sim','🧩 '+(cur.simTitle||'Übung')]);
  if(cur.quiz) tabs.push(['quiz','❓ Quiz']);
  tabs.push(['glossar','📚 Glossar']);
  if(cur.medien&&cur.medien.length) tabs.push(['zusatz','🎬 Zusatz']);
  v.innerHTML=`
    <div class="st-head"><div class="bar" style="background:${cur.color}"></div>
      <div class="row1"><div class="ic">${cur.ic}</div>
        <div><div class="nr">STATION ${cur.nr} · ${esc(cur.buch)}</div><h2>${esc(cur.title)}</h2></div></div>
      <p class="leit">🧭 <b>Leitfrage:</b> ${esc(cur.leit)}</p>
      <div class="kann"><b>Das kann ich am Ende:</b><ul>${cur.kann.map(k=>'<li>'+esc(k)+'</li>').join('')}</ul></div>
      <div class="komp">${(cur.komp||[]).map(k=>'<span class="k" title="'+KOMP_LABEL[k]+'">'+k+'</span>').join('')}</div>
    </div>
    <div class="tabs">${tabs.map((t,i)=>`<button class="tab ${i===0?'active':''}" data-tab="${t[0]}" onclick="switchTab('${t[0]}')">${t[1]}</button>`).join('')}</div>
    <div id="panels"></div>
    <div class="st-foot">
      <button class="mark-done ${state.done[cur.id]?'is-done':''}" id="markBtn" onclick="toggleDone()">${state.done[cur.id]?'✓ erledigt (klicken zum Zurücksetzen)':'Station als erledigt markieren'}</button>
      <div class="nav-lr">${prevNextBtns()}</div>
    </div>`;
  const p=document.getElementById('panels');
  p.innerHTML=tabs.map((t,i)=>`<div class="panel ${i===0?'active':''}" id="p-${t[0]}">${renderPanel(t[0])}</div>`).join('');
  afterPanelRender();
  window.scrollTo({top:0});
}
function prevNextBtns(){
  const i=STATIONS.indexOf(cur); let out='';
  if(i>0) out+=`<button onclick="openStation('${STATIONS[i-1].id}')">← ${esc(STATIONS[i-1].title.slice(0,18))}…</button>`;
  if(i<STATIONS.length-1) out+=`<button onclick="openStation('${STATIONS[i+1].id}')">${esc(STATIONS[i+1].title.slice(0,18))}… →</button>`;
  return out;
}
function switchTab(id){
  document.querySelectorAll('#stationView .tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===id));
  document.querySelectorAll('#panels .panel').forEach(p=>p.classList.toggle('active',p.id==='p-'+id));
  if(id==='quiz') renderQuiz();
}
function toggleDone(){
  state.done[cur.id]=!state.done[cur.id]; save();
  document.getElementById('markBtn').classList.toggle('is-done',state.done[cur.id]);
  document.getElementById('markBtn').textContent=state.done[cur.id]?'✓ erledigt (klicken zum Zurücksetzen)':'Station als erledigt markieren';
  if(state.done[cur.id]) toast('Station als erledigt markiert 🎉');
  updateProgress();
}

/* ---------- Panels ---------- */
function renderPanel(id){
  if(id==='text') return renderText();
  if(id==='quelle') return renderQuelle();
  if(id==='sim') return `<div class="card"><h3>🧩 ${esc(cur.simTitle||'Übung')}</h3><div id="simHost"></div></div>`;
  if(id==='quiz') return `<div class="card" id="quizHost"></div>`;
  if(id==='glossar') return renderGlossar();
  if(id==='zusatz') return renderZusatz();
  return '';
}
function afterPanelRender(){
  setLevel(state.level[cur.id]||'mittel', true);
  if(cur.sim) renderSim();
}

