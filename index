function renderAuftrag(l){
  const host=document.getElementById('auftragHost'); if(!host) return;
  const tasks=cur.levels[l]||[];
  const rows=tasks.map((t,i)=>{
    const afb=t.stufe?`<span class="op afb">${t.stufe}</span>`:'';
    const op=t.op?`<span class="op">${esc(t.op)}</span>`:'';
    const heft=t.heft?HEFT(t.heftNr||(i+1)):'';
    return `<div class="task">${afb}${op}${annotate(t.txt)} ${heft}
      ${t.muster?`<div><button class="reveal-btn" onclick="this.nextElementSibling.classList.toggle('show')">💡 Musterlösung anzeigen/verbergen</button>
      <div class="muster"><b>Gesichertes Ergebnis:</b> ${annotate(t.muster)}</div></div>`:''}</div>`;
  }).join('');
  const consolidated=tasks.filter(t=>t.muster).map((t,i)=>'• '+t.muster).join('<br>');
  host.innerHTML=`<h3>✍️ Arbeitsauftrag – ${l==='basis'?'🟢 Stufe 1':l==='mittel'?'🟡 Stufe 2':'🔵 Stufe 3'}</h3>
    ${rows}
    <div class="mappe"><div class="m-h">📓 In die Mappe abschreiben</div>
      <p style="margin:0 0 8px;color:var(--muted);font-size:.9rem">Vergleiche deine Antworten mit der Musterlösung. Schreibe anschließend das gesicherte Ergebnis sauber in deine Mappe.</p>
