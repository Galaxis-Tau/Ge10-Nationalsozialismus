  const key=l==='basis'?'n1':l==='mittel'?'n2':'n3';
  tb.innerHTML=paras(cur.texte[key]);
  // Wortspeicher nur Stufe 1
  const ws=document.getElementById('wsHost');
  if(l==='basis'&&cur.wortspeicher){
    ws.innerHTML=`<div class="wortspeicher"><b>🗝️ Wortspeicher – nutze diese Wörter:</b><div class="pills">${cur.wortspeicher.map(w=>'<span class="pill">'+esc(w)+'</span>').join('')}</div></div>`;
  } else ws.innerHTML='';
