function openEinstufung(){
  estAnswers={};
  document.getElementById('home').style.display='none';
  const v=document.getElementById('stationView'); v.classList.add('active');
  v.innerHTML=`<div class="est-wrap">
    <div class="st-head"><div class="bar" style="background:var(--brand)"></div>
      <div class="row1"><div class="ic">🎯</div><div><div class="nr">STATION 0</div><h2>Einstufungstest</h2></div></div>
      <p class="leit">Kreuze ehrlich an, was am besten zu dir passt. Es gibt kein „richtig“ oder „falsch“ – der Bogen hilft dir nur, die passende Stufe zu finden. Du kannst die Stufe an jeder Station später selbst ändern.</p>
    </div>
    <div id="estQs">${EINSTUFUNG.map((q,i)=>`<div class="est-q"><div class="qh">${i+1}. ${esc(q.f)}</div>
      <div class="est-opts">${q.o.map((o,k)=>`<button class="est-opt" data-q="${i}" data-p="${o[1]}" onclick="estPick(${i},${o[1]},this)">${esc(o[0])}</button>`).join('')}</div></div>`).join('')}</div>
    <button class="check-btn" style="background:var(--brand)" onclick="estAuswerten()">Auswerten &amp; Empfehlung anzeigen</button>
    <div class="est-result" id="estResult"></div>
  </div>`;
  window.scrollTo({top:0});
}
function estPick(i,p,btn){
  estAnswers[i]=p;
  [...btn.parentElement.children].forEach(b=>b.classList.remove('sel'));
  btn.classList.add('sel');
}
function estAuswerten(){
  const keys=Object.keys(estAnswers);
  if(keys.length<EINSTUFUNG.length){ toast('Bitte beantworte zuerst alle Fragen.'); return; }
  let sum=0; keys.forEach(k=>sum+=estAnswers[k]);
  const avg=sum/EINSTUFUNG.length;
  let lvl,badge,txt;
  if(avg<1.7){ lvl='basis'; badge='b1'; txt='🟢 Stufe 1 (leicht)'; }
  else if(avg<2.4){ lvl='mittel'; badge='b2'; txt='🟡 Stufe 2 (mittel)'; }
  else { lvl='erweitert'; badge='b3'; txt='🔵 Stufe 3 (anspruchsvoll)'; }
  const tips={basis:'Du startest mit kurzen Texten, Wortspeicher und klaren Schritten. Trau dich, zwischendurch auch Stufe 2 zu testen!',
    mittel:'Du arbeitest auf Schulbuch-Niveau. Wenn dir etwas leichtfällt, probiere ruhig Stufe 3.',
    erweitert:'Du begründest, vergleichst und beurteilst. Nutze die Musterlösungen zum Vergleichen.'};
  const r=document.getElementById('estResult');
  r.className='est-result show';
  r.innerHTML=`<p style="margin:0 0 4px;color:var(--muted)">Deine Empfehlung</p>
    <div class="badge ${badge}">${txt}</div>
    <p>${tips[lvl]}</p>
    <button class="mark-done" style="background:var(--brand)" onclick="applyRecommendation('${lvl}')">Empfehlung übernehmen &amp; starten</button>
    <p style="margin-top:12px;font-size:.85rem;color:var(--muted)">Du bleibst frei: An jeder Station kannst du die Stufe jederzeit umschalten.</p>`;
  if(r.scrollIntoView) r.scrollIntoView({behavior:'smooth',block:'center'});
}
function applyRecommendation(lvl){
  state.recommendedLevel=lvl;
  STATIONS.forEach(s=>{ if(!state.done[s.id]) state.level[s.id]=lvl; });
  save();
  toast('Empfehlung übernommen: '+({basis:'Stufe 1',mittel:'Stufe 2',erweitert:'Stufe 3'})[lvl]);
  goHome();
}

