let quizState={};
function renderQuiz(){
  const host=document.getElementById('quizHost'); if(!host||!cur.quiz) return;
  quizState={answered:{},correct:{}};
  const fragen=cur.quiz.fragen;
  const body=fragen.map((f,qi)=>{
    const opts=shuffle(f.opt);
    return `<div class="qq" id="qq-${qi}"><div class="qtxt">${qi+1}. ${annotate(f.frage)}</div>
      ${opts.map(o=>`<button class="opt" onclick="answer(${qi},this,${o.c?1:0},'${escAttr(o.fb||'')}')">${esc(o.t)}<span class="fb"></span></button>`).join('')}</div>`;
  }).join('');
  const solved=state.solved[cur.id];
  host.innerHTML=`<div class="instruction">❓ Beantworte alle Fragen. Bei jedem Aufruf werden die Antworten neu gemischt. Erst wenn <b>alles richtig</b> ist, erscheint das Lösungswort für den Laufzettel.</div>
    <div class="quiz-tools"><button class="ghost" onclick="renderQuiz()">🔀 Neu mischen</button><small style="color:var(--muted)">${fragen.length} Fragen</small></div>
    ${body}
    <div class="lw ${solved?'solved':'locked'}" id="lwbox"><div>🔑 Lösungswort</div><div class="word">${esc(cur.quiz.lw)}</div><small>${solved?'Freigeschaltet – ab in den Laufzettel!':'Noch gesperrt: beantworte alle Fragen richtig.'}</small></div>`;
}
function answer(qi,btn,correct,fb){
  const box=document.getElementById('qq-'+qi);
  box.querySelectorAll('.opt').forEach(b=>{b.disabled=false;});
  // reset styles in this question
  box.querySelectorAll('.opt').forEach(b=>{b.classList.remove('correct','wrong'); b.querySelector('.fb').textContent='';});
  btn.classList.add(correct?'correct':'wrong');
  btn.querySelector('.fb').textContent=(correct?'✅ ':'❌ ')+fb;
  quizState.answered[qi]=true; quizState.correct[qi]=!!correct;
  const total=cur.quiz.fragen.length;
  const allCorrect=Object.keys(quizState.correct).length===total && Object.values(quizState.correct).every(Boolean);
  if(allCorrect){
    state.solved[cur.id]=true; save();
    const lw=document.getElementById('lwbox'); lw.classList.remove('locked'); lw.classList.add('solved');
    lw.querySelector('small').textContent='Freigeschaltet – ab in den Laufzettel!';
    toast('Alles richtig! Lösungswort freigeschaltet 🔑');
  }
}

